{
    "name": "sistema/new",
    "license": "propietary",
    "description": "Sistema moderno con PHP + AdminLTE 4 + Bootstrap 5",
    "type": "project",
    "require": {
        "monolog/monolog": "3.9.0",
        "vlucas/phpdotenv": "5.6.2",
        "phpoffice/phpspreadsheet": "5.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Backend\\": "backend/",
            "Api\\": "api/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.17"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
